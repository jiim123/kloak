{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kloak",
  "version": "0.0.0",
  "identifier": "com.kloak.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://kloak.lovable.app/auth?mode=login",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Kloak",
        "width": 800,
        "height": 600,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
